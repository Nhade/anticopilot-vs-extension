{
  "name": "anti-copilot",
  "displayName": "anti-copilot",
  "publisher": "anticopilot",
  "description": "An extension to focus on skill growth instead of just getting the job done.",
  "version": "0.0.1",
  "engines": {
    "vscode": "^1.109.0"
  },
  "categories": [
    "Other"
  ],
  "activationEvents": [
    "onUri"
  ],
  "main": "./dist/extension.js",
  "contributes": {
    "commands": [
      {
        "command": "anti-copilot.reportStruggle",
        "title": "AntiCopilot: I'm Stuck (Report Struggle)"
      },
      {
        "command": "anti-copilot.highlightDiagnostics",
        "title": "AntiCopilot: Highlight Diagnostics"
      },
      {
        "command": "anti-copilot.openSidebar",
        "title": "AntiCopilot: Open Sidebar (Webview View)"
      },
      {
        "command": "anti-copilot.dumpEventBuffer",
        "title": "AntiCopilot: Dump Shadow Event Buffer (Debug)"
      }
    ],
    "viewsContainers": {
      "activitybar": [
        {
          "id": "sidebar-webview",
          "title": "AntiCopilot",
          "icon": "resources/sushi.svg"
        }
      ]
    },
    "views": {
      "sidebar-webview": [
        {
          "type": "webview",
          "id": "anti-copilot.sidebar",
          "name": "sidebar"
        }
      ]
    },
    "configuration": {
      "title": "AntiCopilot",
      "properties": {
        "antiCopilot.apiBaseUrl": {
          "type": "string",
          "default": "http://127.0.0.1:8000",
          "description": "Base URL for the AntiCopilot backend REST API."
        },
        "antiCopilot.userId": {
          "type": "string",
          "default": "default-user",
          "description": "Development user ID sent to AntiCopilot REST endpoints until authentication is available."
        },
        "antiCopilot.sidecarBaseUrl": {
          "type": "string",
          "default": "http://127.0.0.1:9100",
          "description": "Base URL for the AntiCopilot struggle sidecar (HTTP + WebSocket) service."
        },
        "antiCopilot.sidecarToken": {
          "type": "string",
          "default": "dev-sidecar-token",
          "description": "Shared service token sent to the struggle sidecar (Bearer header for REST, ?token= query param for WebSocket)."
        },
        "antiCopilot.sidecarEnabled": {
          "type": "boolean",
          "default": true,
          "description": "Toggle the struggle sidecar integration (passive session telemetry, completeness estimates, remote capture)."
        }
      }
    }
  },
  "scripts": {
    "vscode:prepublish": "npm run package",
    "compile": "npm run check-types && npm run lint && node esbuild.js",
    "watch": "npm-run-all -p watch:*",
    "watch:esbuild": "node esbuild.js --watch",
    "watch:tsc": "tsc --noEmit --watch --project tsconfig.json",
    "package": "npm run check-types && npm run lint && node esbuild.js --production",
    "compile-tests": "tsc -p . --outDir out",
    "watch-tests": "tsc -p . -w --outDir out",
    "pretest": "npm run compile-tests && npm run compile && npm run lint",
    "check-types": "tsc --noEmit",
    "lint": "eslint src",
    "test": "vscode-test"
  },
  "devDependencies": {
    "@types/vscode": "^1.109.0",
    "@types/mocha": "^10.0.10",
    "@types/node": "22.x",
    "@types/ws": "^8.5.12",
    "typescript-eslint": "^8.54.0",
    "eslint": "^9.39.2",
    "esbuild": "^0.27.2",
    "npm-run-all": "^4.1.5",
    "typescript": "^5.9.3",
    "@vscode/test-cli": "^0.0.12",
    "@vscode/test-electron": "^2.5.2"
  },
  "dependencies": {
    "ws": "^8.18.0"
  }
}
